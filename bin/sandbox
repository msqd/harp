#! /bin/bash
#
# This script will execute something in a clean copy of the local git repository, pinned to HEAD's commit.
# It's mostly useful to ensure that a local build completely ignore local changes and non versionned files, helping
# builds to be more predictible.
#
# Usage: bin/sandbox some-command with some args
#
# Environment variables:
#   SANDBOX_ALLOW_DIRTY - if non-empty, allows running with uncommitted changes
#   SANDBOX_KEEP        - if non-empty, keeps the sandbox directory after execution
#
# Brought to you by Makersquad and licensed under the DO WHAT THE FUCK YOU WANT TO PUBLIC LICENSE, version 2.
#

__PATH__=$(cd $(dirname "$0")/..; pwd)

# Configuration from environment
SANDBOX_ALLOW_DIRTY=${SANDBOX_ALLOW_DIRTY:-}
SANDBOX_KEEP=${SANDBOX_KEEP:-}

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Exit if something fails
set -e

# Set version
export VERSION=`git describe 2>/dev/null || git rev-parse --short HEAD`

# If there are local changes, force the user to clean things up (he may not expect his changes to be ignored, so
# it's better that he choses to stash, revert or commit the things).
if [ -z "$SANDBOX_ALLOW_DIRTY" ]; then
  git diff-index --quiet --cached HEAD -- || {
    echo -e "${RED}❌ Repository not clean, please explicitely act so I am certain you're not ignoring something you expected to have in your sandbox.${NC}"
    echo -e "${YELLOW}💡 Tip: Set SANDBOX_ALLOW_DIRTY=1 to bypass this check${NC}"
    exit 1
  }
else
  echo -e "${YELLOW}⚠️ Running with SANDBOX_ALLOW_DIRTY - uncommitted changes will be ignored${NC}"
fi

# Create temporary sandbox and trap removal at exit
SANDBOX=`mktemp -d`
SANDBOX_WC=$SANDBOX/working-copy

echo -e "${BLUE}📦 Created sandbox directory: ${GREEN}$SANDBOX${NC}"

function cleanup {
  if [ -n "$SANDBOX_KEEP" ]; then
    echo -e "${BLUE}📦 Kept sandbox directory: $SANDBOX_WC${NC}"
  else
    rm -rf $SANDBOX
    echo -e "${BLUE}📦 Removed sandbox directory: $SANDBOX${NC}"
  fi
}
trap cleanup EXIT

# Clean clone
echo -e "${BLUE}📦 Cloning repository at version ${GREEN}$VERSION${NC}"
(cd $SANDBOX; git clone $__PATH__ working-copy --no-checkout)
(cd $SANDBOX_WC; git -c advice.detachedHead=false checkout $VERSION)
(cd $SANDBOX_WC; git submodule update --init --recursive)
(cd $SANDBOX_WC; rm -rf .git)
(cd $SANDBOX_WC; touch .env)

# Execute
echo -e "${BLUE}📦 Executing command in sandbox${NC}"
ARGS="$*"
(cd $SANDBOX_WC; bash -c "$ARGS" )
exit $?

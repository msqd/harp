#!/bin/bash
#
# Build a wheel package in a sandboxed environment
#
# This script is meant to be run inside bin/sandbox
#

set -e
set -x

# Install dependencies and build frontend
make install-dev build-frontend

# Remove unnecessary files from the wheel (frontend source, keep only built assets in web/)
rm -rf harp_apps/dashboard/frontend
rm -rf harp_apps/dashboard/web/src

# Verify web directory still exists after removal
ls -la harp_apps/dashboard/web/index.html > /dev/null || echo "ERROR: web directory index is missing!"

# Clean up README (remove People & Credits section)
sed '/^People & Credits/,$ d' README.rst > README.rst.tmp
mv README.rst.tmp README.rst

# Build the wheel
if [ -n "$UV" ]; then
    $UV build
else
    python -m build
fi

# Copy to the original dist directory
cp dist/* "$PWD_ORIG/dist/"

# Verify frontend assets are included in the wheel.
#
# Counted with python's zipfile rather than `unzip`, which is not installed
# everywhere. When the tool is missing the count comes back 0 and the check
# reports missing assets, which is a plausible and completely wrong diagnosis
# arriving at the exact moment someone is cutting a release. python is already
# a hard requirement here, since it just built the wheel.
WHEEL_FILE=$(ls dist/*.whl)
WEB_ASSET_COUNT=$(python -c 'import sys, zipfile; print(sum(1 for n in zipfile.ZipFile(sys.argv[1]).namelist() if n.startswith("harp_apps/dashboard/web/")))' "$WHEEL_FILE")
printf "\n📊 Wheel contains %d files in harp_apps/dashboard/web/\n\n" "$WEB_ASSET_COUNT" >&2
if [ "$WEB_ASSET_COUNT" -lt 10 ]; then
    printf "❌ ERROR: Expected at least 10 web assets, but found only %d\n" "$WEB_ASSET_COUNT" >&2
    printf "This likely means frontend assets were not included in the wheel!\n" >&2
    exit 1
fi

# Check the wheel with twine
if [ -n "$UVX" ]; then
    $UVX twine check dist/*
else
    twine check dist/*
fi

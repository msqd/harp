{
  "$defs": {
    "BasicAuthSettings": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "basic",
          "default": null,
          "description": "Authentication type.",
          "type": "string"
        },
        "algorithm": {
          "default": "pbkdf2_sha256",
          "description": "Hashing algorithm used for passwords.",
          "enum": [
            "argon2",
            "bcrypt",
            "bcrypt_sha256",
            "cisco_asa",
            "cisco_pix",
            "cisco_type7",
            "django_bcrypt",
            "django_bcrypt_sha256",
            "django_des_crypt",
            "django_disabled",
            "django_pbkdf2_sha1",
            "django_pbkdf2_sha256",
            "django_salted_md5",
            "django_salted_sha1",
            "grub_pbkdf2_sha512",
            "hex_digest",
            "ldap_crypt",
            "ldap_md5",
            "ldap_plaintext",
            "ldap_salted_md5",
            "ldap_salted_sha1",
            "ldap_salted_sha256",
            "ldap_salted_sha512",
            "ldap_sha1",
            "lmhash",
            "md5_crypt",
            "msdcc",
            "msdcc2",
            "mssql2000",
            "mssql2005",
            "mysql323",
            "mysql41",
            "nthash",
            "oracle10",
            "oracle11",
            "pbkdf2_sha1",
            "pbkdf2_sha256",
            "pbkdf2_sha512",
            "phpass",
            "plain",
            "plaintext",
            "postgres_md5",
            "scram",
            "scrypt",
            "sha256_crypt",
            "sha512_crypt"
          ],
          "type": "string"
        },
        "users": {
          "additionalProperties": { "$ref": "#/$defs/User" },
          "description": "Users list.",
          "title": "Users",
          "type": "object"
        }
      },
      "title": "BasicAuthSettings",
      "type": "object"
    },
    "ChangePasswordInput": {
      "additionalProperties": false,
      "properties": {
        "current": { "type": "string" },
        "new": { "type": "string" }
      },
      "required": ["current", "new"],
      "title": "ChangePasswordInput",
      "type": "object"
    },
    "DashboardSettings": {
      "additionalProperties": false,
      "description": "Root settings for the dashboard application.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether the application is enabled",
          "type": "boolean"
        },
        "host": {
          "default": "[::]",
          "description": "Address on which the dashboard application will listen. The default listens on every interface, which a published Docker port needs. Use `127.0.0.1` to listen on the loopback interface only.",
          "type": "string"
        },
        "port": {
          "default": 4080,
          "description": "Port on which the dashboard application will be served.",
          "type": "integer"
        },
        "metrics_port": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "default": null,
          "description": "Port on which the Prometheus metrics (`/metrics`) are also served, unauthenticated. Disabled by default. Metrics are always served on the dashboard port, under the dashboard authentication."
        },
        "auth": {
          "anyOf": [
            { "$ref": "#/$defs/BasicAuthSettings" },
            { "type": "null" }
          ],
          "default": null,
          "description": "Deprecated. Dashboard users declared in the configuration, signing in with HTTP Basic. They are imported once as accounts. When not set, the dashboard signs people in with a password, and a setup link logged at start lets the first administrator in. There is no way to serve the dashboard without authentication."
        },
        "devserver": {
          "anyOf": [
            { "$ref": "#/$defs/DevserverSettings" },
            { "type": "null" }
          ],
          "description": "Development server settings, only useful for internal frontend development."
        },
        "public_url": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Public URL of the dashboard application, used to generate absolute links, for example in notifications."
        }
      },
      "title": "DashboardSettings",
      "type": "object"
    },
    "DevserverSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable or disable the development server.",
          "type": "boolean"
        },
        "port": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "default": null,
          "description": "Port on which the development server will be served (internal). The proxy will forward dashboard requests to this port, if enabled."
        }
      },
      "title": "DevserverSettings",
      "type": "object"
    },
    "NoInput": {
      "additionalProperties": false,
      "description": "Routes that need nothing still take a JSON body (``{}``), which is what keeps a cross-site form out.",
      "properties": {},
      "title": "NoInput",
      "type": "object"
    },
    "SetupInput": {
      "additionalProperties": false,
      "properties": {
        "secret": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["secret", "username", "password"],
      "title": "SetupInput",
      "type": "object"
    },
    "SignInInput": {
      "additionalProperties": false,
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["username", "password"],
      "title": "SignInInput",
      "type": "object"
    },
    "SystemPutProxyInput": {
      "properties": {
        "endpoint": { "type": "string" },
        "action": { "enum": ["up", "down", "checking"], "type": "string" },
        "index": { "type": "integer" }
      },
      "required": ["endpoint", "action", "index"],
      "title": "SystemPutProxyInput",
      "type": "object"
    },
    "User": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "format": "password",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": ["password"],
      "title": "User",
      "type": "object"
    }
  },
  "title": "__ROOT__",
  "anyOf": [
    { "$ref": "#/$defs/ChangePasswordInput" },
    { "$ref": "#/$defs/NoInput" },
    { "$ref": "#/$defs/SetupInput" },
    { "$ref": "#/$defs/SignInInput" },
    { "$ref": "#/$defs/SystemPutProxyInput" },
    { "$ref": "#/$defs/DashboardSettings" },
    { "$ref": "#/$defs/BasicAuthSettings" },
    { "$ref": "#/$defs/User" },
    { "$ref": "#/$defs/DevserverSettings" }
  ]
}

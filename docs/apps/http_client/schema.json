{
  "$defs": {
    "HttpClientSettings": {
      "additionalProperties": true,
      "properties": {
        "base": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Base type for service definition."
        },
        "type": {
          "default": "httpx.AsyncClient",
          "description": "Type for service definition.",
          "type": "string"
        },
        "constructor": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Optional custom constructor for the service."
        },
        "arguments": {
          "additionalProperties": true,
          "default": { "timeout": 30.0 },
          "title": "Arguments",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "description": "Whether the application is enabled",
          "type": "boolean"
        },
        "transport": {
          "$ref": "#/$defs/Service",
          "default": {
            "type": "httpx.AsyncHTTPTransport",
            "verify": true,
            "retries": 0
          }
        },
        "proxy_transport": {
          "$ref": "#/$defs/Service",
          "default": {
            "type": "harp_apps.http_client.transports.AsyncFilterableTransport"
          }
        }
      },
      "title": "HttpClientSettings",
      "type": "object"
    },
    "Service": {
      "additionalProperties": true,
      "description": "A settings base class for service definitions.",
      "properties": {
        "base": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Base type for service definition."
        },
        "type": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Type for service definition."
        },
        "constructor": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Optional custom constructor for the service."
        },
        "arguments": {
          "anyOf": [
            { "additionalProperties": true, "type": "object" },
            { "type": "null" }
          ],
          "description": "Arguments for the service constructor."
        }
      },
      "title": "Service",
      "type": "object"
    }
  },
  "title": "__ROOT__",
  "anyOf": [{ "$ref": "#/$defs/HttpClientSettings" }]
}

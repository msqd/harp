{
  "$defs": {
    "CachePolicyOptions": {
      "additionalProperties": false,
      "description": "Options of the cache policy, mapped onto ``hishel.CacheOptions``.",
      "properties": {
        "shared": { "default": true, "type": "boolean" },
        "supported_methods": { "items": { "type": "string" }, "type": "array" },
        "allow_stale": { "default": false, "type": "boolean" }
      },
      "title": "CachePolicyOptions",
      "type": "object"
    },
    "CachePolicySettings": {
      "additionalProperties": true,
      "properties": {
        "base": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Base type for service definition."
        },
        "type": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Type for service definition."
        },
        "constructor": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Optional custom constructor for the service."
        },
        "arguments": {
          "anyOf": [
            { "additionalProperties": true, "type": "object" },
            { "type": "null" }
          ],
          "description": "Arguments for the service constructor."
        },
        "options": { "$ref": "#/$defs/CachePolicyOptions" }
      },
      "title": "CachePolicySettings",
      "type": "object"
    },
    "HttpCacheSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether the application is enabled",
          "type": "boolean"
        },
        "transport": {
          "$ref": "#/$defs/Service",
          "default": {
            "base": "hishel._async_httpx.AsyncCacheTransport",
            "type": "harp_apps.http_cache.transports.AsyncCacheTransport"
          }
        },
        "policy": {
          "$ref": "#/$defs/CachePolicySettings",
          "default": {
            "type": "hishel.SpecificationPolicy",
            "options": {
              "allow_stale": false,
              "shared": true,
              "supported_methods": ["GET", "HEAD"]
            }
          }
        },
        "purge": { "$ref": "#/$defs/PurgeSettings" },
        "reclamation": { "$ref": "#/$defs/ReclamationSettings" },
        "redis": { "$ref": "#/$defs/RedisRecordsSettings" },
        "storage": {
          "$ref": "#/$defs/Service",
          "default": {
            "base": "hishel.AsyncBaseStorage",
            "type": "harp_apps.http_cache.storages.AsyncStorage",
            "ttl": 86400,
            "check_ttl_every": 60.0,
            "allow_heuristics": false
          }
        }
      },
      "title": "HttpCacheSettings",
      "type": "object"
    },
    "PurgeSettings": {
      "additionalProperties": false,
      "description": "``PURGE`` removes one cache entry, for the peers allowed to ask.",
      "properties": {
        "enabled": { "default": false, "type": "boolean" },
        "allow": {
          "items": { "format": "ipvanynetwork", "type": "string" },
          "type": "array"
        }
      },
      "title": "PurgeSettings",
      "type": "object"
    },
    "ReclamationSettings": {
      "additionalProperties": false,
      "description": "How the invalidation log is reclaimed: the entries old bans cover are deleted, then the bans retired.",
      "properties": {
        "grace": { "default": 300, "minimum": 0, "type": "number" },
        "bans": { "default": 1000, "exclusiveMinimum": 0, "type": "integer" },
        "entries": { "default": 500, "exclusiveMinimum": 0, "type": "integer" },
        "rounds": { "default": 20, "exclusiveMinimum": 0, "type": "integer" }
      },
      "title": "ReclamationSettings",
      "type": "object"
    },
    "RedisRecordsSettings": {
      "additionalProperties": false,
      "description": "The records of the cache in Redis, which hold them when Redis is the blob storage of the ``storage`` application.",
      "properties": {
        "prefix": { "default": "harp:cache:", "type": "string" },
        "retention": { "default": 2592000, "exclusiveMinimum": 0, "type": "number" }
      },
      "title": "RedisRecordsSettings",
      "type": "object"
    },
    "Service": {
      "additionalProperties": true,
      "description": "A settings base class for service definitions.",
      "properties": {
        "base": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Base type for service definition."
        },
        "type": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Type for service definition."
        },
        "constructor": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Optional custom constructor for the service."
        },
        "arguments": {
          "anyOf": [
            { "additionalProperties": true, "type": "object" },
            { "type": "null" }
          ],
          "description": "Arguments for the service constructor."
        }
      },
      "title": "Service",
      "type": "object"
    }
  },
  "title": "__ROOT__",
  "anyOf": [
    { "$ref": "#/$defs/CachePolicyOptions" },
    { "$ref": "#/$defs/CachePolicySettings" },
    { "$ref": "#/$defs/HttpCacheSettings" },
    { "$ref": "#/$defs/PurgeSettings" },
    { "$ref": "#/$defs/ReclamationSettings" },
    { "$ref": "#/$defs/RedisRecordsSettings" }
  ]
}

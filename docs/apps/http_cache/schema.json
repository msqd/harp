{
  "$defs": {
    "CachePolicyOptions": {
      "additionalProperties": false,
      "description": "Options of the cache policy, mapped onto ``hishel.CacheOptions``.",
      "properties": {
        "shared": { "default": true, "type": "boolean" },
        "supported_methods": { "items": { "type": "string" }, "type": "array" },
        "allow_stale": { "default": false, "type": "boolean" }
      },
      "title": "CachePolicyOptions",
      "type": "object"
    },
    "CachePolicySettings": {
      "additionalProperties": true,
      "properties": {
        "base": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Base type for service definition."
        },
        "type": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Type for service definition."
        },
        "constructor": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Optional custom constructor for the service."
        },
        "arguments": {
          "anyOf": [
            { "additionalProperties": true, "type": "object" },
            { "type": "null" }
          ],
          "description": "Arguments for the service constructor."
        },
        "options": { "$ref": "#/$defs/CachePolicyOptions" }
      },
      "title": "CachePolicySettings",
      "type": "object"
    },
    "HttpCacheSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether the application is enabled",
          "type": "boolean"
        },
        "transport": {
          "$ref": "#/$defs/Service",
          "default": {
            "base": "hishel._async_httpx.AsyncCacheTransport",
            "type": "harp_apps.http_cache.transports.AsyncCacheTransport"
          }
        },
        "policy": {
          "$ref": "#/$defs/CachePolicySettings",
          "default": {
            "type": "hishel.SpecificationPolicy",
            "options": {
              "allow_stale": false,
              "shared": true,
              "supported_methods": ["GET", "HEAD"]
            }
          }
        },
        "purge": {
          "$ref": "#/$defs/PurgeSettings",
          "default": { "enabled": false, "allow": [] }
        },
        "storage": {
          "$ref": "#/$defs/Service",
          "default": {
            "base": "hishel.AsyncBaseStorage",
            "type": "harp_apps.http_cache.storages.AsyncStorage",
            "ttl": 86400,
            "check_ttl_every": 60.0,
            "allow_heuristics": false
          }
        }
      },
      "title": "HttpCacheSettings",
      "type": "object"
    },
    "PurgeSettings": {
      "additionalProperties": false,
      "description": "``PURGE`` removes one cache entry, for the peers allowed to ask.",
      "properties": {
        "enabled": { "default": false, "type": "boolean" },
        "allow": {
          "items": { "format": "ipvanynetwork", "type": "string" },
          "type": "array"
        }
      },
      "title": "PurgeSettings",
      "type": "object"
    },
    "Service": {
      "additionalProperties": true,
      "description": "A settings base class for service definitions.",
      "properties": {
        "base": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Base type for service definition."
        },
        "type": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Type for service definition."
        },
        "constructor": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Optional custom constructor for the service."
        },
        "arguments": {
          "anyOf": [
            { "additionalProperties": true, "type": "object" },
            { "type": "null" }
          ],
          "description": "Arguments for the service constructor."
        }
      },
      "title": "Service",
      "type": "object"
    }
  },
  "title": "__ROOT__",
  "anyOf": [
    { "$ref": "#/$defs/CachePolicyOptions" },
    { "$ref": "#/$defs/CachePolicySettings" },
    { "$ref": "#/$defs/HttpCacheSettings" },
    { "$ref": "#/$defs/PurgeSettings" }
  ]
}

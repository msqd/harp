digraph "how-it-works-proxy" {
    rankdir = LR
    bgcolor = "white"
    compound = true
    nodesep = 0.35
    ranksep = 0.9
    fontname = "Helvetica"
    node [shape = box, style = "rounded,filled", fillcolor = white, color = "#444444", fontname = "Helvetica", fontsize = 13, margin = "0.25,0.15"]
    edge [color = "#444444", fontname = "Helvetica", fontsize = 11]

    subgraph cluster_apps {
        label = "APPLICATIONS"
        labeljust = l
        style = "rounded,filled"
        color = "#d08a20"
        fillcolor = "#fcfaf4"
        fontsize = 11

        app1 [label = "Your\nApplication 1"]
        app2 [label = "Your\nApplication 2"]
    }

    subgraph cluster_proxy {
        label = "HARP PROXY"
        labeljust = l
        style = "rounded,filled"
        color = "#3aa655"
        fillcolor = "#f4fbf6"
        fontsize = 11

        controller [label = "Proxy Controller"]
        features [label = "Cache, circuit breaker,\nrules, ..."]
        storages [label = "Storages", shape = cylinder]
        controller -> features [dir = both, style = dotted]
        features -> storages [dir = both, style = dotted]
        {rank = same; controller; features; storages}
    }

    subgraph cluster_external {
        label = "EXTERNAL API"
        labeljust = l
        style = "rounded,filled"
        color = "#888888"
        fillcolor = "#f6f6f6"
        fontsize = 11

        api1 [label = "External API 1", fillcolor = "#e6e6e6"]
        api2 [label = "External API 2", fillcolor = "#e6e6e6"]
    }

    app1 -> controller [label = "HTTP", lhead = cluster_proxy]
    app2 -> controller [label = "HTTP", lhead = cluster_proxy]
    controller -> api1 [label = "HTTP", ltail = cluster_proxy]
    controller -> api2 [label = "HTTP", ltail = cluster_proxy]
}

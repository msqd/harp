digraph "how-it-works-multiple-apps" {
    rankdir = LR
    bgcolor = "white"
    compound = true
    nodesep = 0.4
    ranksep = 1.0
    fontname = "Helvetica"
    node [shape = box, style = "rounded,filled", fillcolor = white, color = "#444444", fontname = "Helvetica", fontsize = 13, margin = "0.25,0.15"]
    edge [color = "#444444", fontname = "Helvetica", fontsize = 11]

    subgraph cluster_apps {
        label = "YOUR APPLICATIONS"
        labeljust = l
        style = "rounded,filled"
        color = "#d08a20"
        fillcolor = "#fcfaf4"
        fontsize = 11

        app1 [label = "Application 1"]
        app2 [label = "Application 2"]
        app3 [label = "Application 3"]
    }

    harp [label = "HARP", fillcolor = "#f4fbf6", color = "#3aa655", fontsize = 18, width = 1.6, height = 1.6]

    subgraph cluster_external {
        label = "EXTERNAL SERVICES"
        labeljust = l
        style = "rounded,filled"
        color = "#888888"
        fillcolor = "#f6f6f6"
        fontsize = 11

        api1 [label = "External API 1", fillcolor = "#e6e6e6"]
        api2 [label = "External API 2", fillcolor = "#e6e6e6"]
    }

    app1 -> harp [label = "HTTP"]
    app2 -> harp [label = "HTTP"]
    app3 -> harp [label = "HTTP"]
    harp -> api1 [label = "HTTP"]
    harp -> api2 [label = "HTTP"]
}
